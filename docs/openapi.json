{
  "openapi": "3.1.0",
  "info": {
    "title": "Vote Anyway",
    "version": "0.2.0",
    "description": "Authenticated informal topics and encrypted research ballots. See /llms.txt for request signing and agent approval."
  },
  "components": {
    "securitySchemes": {
      "Attest": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Attest followed by base64url JSON signed proof; not an OAuth bearer token."
      }
    }
  },
  "paths": {
    "/api/topics": {
      "get": {
        "summary": "List the latest 100 topics",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Duplicate or replay"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      },
      "post": {
        "summary": "Create and immediately publish an immutable topic",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Duplicate or replay"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "security": [
          {
            "Attest": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  }
                },
                "required": [
                  "title",
                  "question",
                  "options"
                ]
              }
            }
          }
        }
      }
    },
