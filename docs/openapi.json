            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 300
                  },
                  "publicKey": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "string",
                        "minLength": 43,
                        "maxLength": 43
                      },
                      "y": {
                        "type": "string",
                        "minLength": 43,
                        "maxLength": 43
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ]
                  },
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "topics:create",
                        "votes:submit"
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "publicKey",
                  "scopes"
                ]
              }
            }
          }
        }
