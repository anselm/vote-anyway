{
  "name": "vote-anyway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-essay.js",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.js",
    "test:db": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --test test/postgres.integration.test.js",
    "test:original": "npm test --prefix reference/original-prototype-20261020"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "fastify": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "marked": "^18.1.1",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
